{
  "name": "dsh-plugin-blackboard",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: use a blackboard (external Agent memory) as native tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fruit-Guardians/Blackboard_Plugin.git"
  },
  "homepage": "https://github.com/Fruit-Guardians/Blackboard_Plugin#readme",
  "bugs": {
    "url": "https://github.com/Fruit-Guardians/Blackboard_Plugin/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "blackboard",
    "agent-memory",
    "context-recovery"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/",
    "clean:meta": "node scripts/strip-appledouble.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "skill:install:user": "node scripts/install-skill.mjs --user"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
